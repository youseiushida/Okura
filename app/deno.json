{
  "imports": {
    "@std/assert/": "jsr:@std/assert@^1.0.18/",
    "parse5": "npm:parse5@8.0.0"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "start": "deno run --allow-env=JCB_USER_ID,JCB_PASSWORD --allow-net main.ts",
    "jcb": "deno run --allow-env=JCB_USER_ID,JCB_PASSWORD --allow-net main.ts jcb fetch",
    "check": "deno check main.ts internal/**/*.ts",
    "test": "deno test --allow-net=127.0.0.1",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "compile": "deno compile --allow-env=JCB_USER_ID,JCB_PASSWORD --allow-net --output okura.exe main.ts"
  }
}
