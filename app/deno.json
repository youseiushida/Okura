{
  "imports": {
    "@napi-rs/keyring": "npm:@napi-rs/keyring@1.3.0",
    "@std/assert/": "jsr:@std/assert@^1.0.18/",
    "@types/jsdom": "npm:@types/jsdom@^30.0.0",
    "jsdom": "npm:jsdom@^30.0.1",
    "parse5": "npm:parse5@8.0.0"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "compile": {
    "include": [
      "internal/adapter/amazon/script_worker.ts",
      "internal/adapter/jcb/protection_worker.ts"
    ]
  },
  "tasks": {
    "start": "deno task start:windows",
    "start:windows": "deno run --unstable-worker-options --allow-env=JCB_USER_ID,JCB_PASSWORD,AMAZON_EMAIL,AMAZON_PASSWORD,MONEYFORWARD_EMAIL,MONEYFORWARD_PASSWORD,LOCALAPPDATA,JEST_WORKER_ID,UNDICI_NO_WASM_SIMD,NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-net --allow-read --allow-write --allow-ffi main.ts",
    "start:macos": "deno run --unstable-worker-options --allow-env=JCB_USER_ID,JCB_PASSWORD,AMAZON_EMAIL,AMAZON_PASSWORD,MONEYFORWARD_EMAIL,MONEYFORWARD_PASSWORD,HOME,JEST_WORKER_ID,UNDICI_NO_WASM_SIMD,NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-net --allow-read --allow-write --allow-ffi main.ts",
    "start:linux": "deno run --unstable-worker-options --allow-env=JCB_USER_ID,JCB_PASSWORD,AMAZON_EMAIL,AMAZON_PASSWORD,MONEYFORWARD_EMAIL,MONEYFORWARD_PASSWORD,HOME,XDG_DATA_HOME,JEST_WORKER_ID,UNDICI_NO_WASM_SIMD --allow-net --allow-read --allow-write --allow-run=secret-tool main.ts",
    "jcb": "deno task start:windows jcb fetch",
    "amazon": "deno task start:windows amazon fetch",
    "moneyforward": "deno task start:windows moneyforward fetch",
    "check": "deno check main.ts internal/**/*.ts smoke/**/*.ts",
    "test": "deno test --unstable-worker-options --allow-env=JEST_WORKER_ID,UNDICI_NO_WASM_SIMD --allow-net=127.0.0.1 --allow-read --allow-write",
    "lint": "deno lint",
    "fmt:check": "deno fmt --check",
    "compile": "deno task compile:windows",
    "compile:windows": "deno compile --unstable-worker-options --allow-env=JCB_USER_ID,JCB_PASSWORD,AMAZON_EMAIL,AMAZON_PASSWORD,MONEYFORWARD_EMAIL,MONEYFORWARD_PASSWORD,LOCALAPPDATA,JEST_WORKER_ID,UNDICI_NO_WASM_SIMD,NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-net --allow-read --allow-write --allow-ffi --output okura.exe main.ts",
    "compile:macos": "deno compile --unstable-worker-options --allow-env=JCB_USER_ID,JCB_PASSWORD,AMAZON_EMAIL,AMAZON_PASSWORD,MONEYFORWARD_EMAIL,MONEYFORWARD_PASSWORD,HOME,JEST_WORKER_ID,UNDICI_NO_WASM_SIMD,NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-net --allow-read --allow-write --allow-ffi --output okura main.ts",
    "compile:linux": "deno compile --unstable-worker-options --allow-env=JCB_USER_ID,JCB_PASSWORD,AMAZON_EMAIL,AMAZON_PASSWORD,MONEYFORWARD_EMAIL,MONEYFORWARD_PASSWORD,HOME,XDG_DATA_HOME,JEST_WORKER_ID,UNDICI_NO_WASM_SIMD --allow-net --allow-read --allow-write --allow-run=secret-tool --output okura main.ts",
    "smoke:storage:windows": "deno run --allow-env=NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-read --allow-write --allow-ffi smoke/native_storage.ts",
    "smoke:storage:macos": "deno run --allow-env=NAPI_RS_NATIVE_LIBRARY_PATH,NAPI_RS_ENFORCE_VERSION_CHECK,NAPI_RS_FORCE_WASI --allow-read --allow-write --allow-ffi smoke/native_storage.ts",
    "smoke:storage:linux": "deno run --allow-read --allow-write --allow-run=secret-tool smoke/native_storage.ts"
  }
}
